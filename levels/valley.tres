separation = 150.0
random_yaw = true

[resource]
script = ExtResource("1_def")
field = ExtResource("2_field")
surface_material = ExtResource("3_material")
environment = ExtResource("4_env")
spawn_clearance = 4.0
trip_fade = 1.2
spawn_manifest = Array[SpawnGroup]([SubResource("Group_tower"), SubResource("Group_enemy")])
spawn_seed = 20260826
kill_heal = 20.0
player_keepout = 26.0
